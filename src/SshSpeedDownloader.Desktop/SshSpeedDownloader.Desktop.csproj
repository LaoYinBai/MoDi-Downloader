<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\modi-downloader.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Description>MoDi cloud-connected download manager</Description>
    <Authors>MoDi</Authors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>MoDiDownloader</AssemblyName>
    <Product>MoDi Downloader</Product>
    <MoDiPrivateBuild Condition="'$(MoDiPrivateBuild)' == ''">false</MoDiPrivateBuild>
    <MoDiPrivateIdentityPath Condition="'$(MoDiPrivateBuild)' == 'true' and '$(MoDiPrivateIdentityPath)' == ''">$(MODI_PRIVATE_IDENTITY_PATH)</MoDiPrivateIdentityPath>
    <DefineConstants Condition="'$(MoDiPrivateBuild)' == 'true' and '$(MoDiPrivateIdentityPath)' != ''">$(DefineConstants);MODI_PRIVATE_BUILD</DefineConstants>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Audio\**" />
    <EmbeddedResource Include="Assets\Audio\completion.wav" LogicalName="MoDiDownloader.CompletionSound.wav" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="MoDiDownloader.ThirdPartyNotices.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SshSpeedDownloader.Core\SshSpeedDownloader.Core.csproj" />
    <ProjectReference Include="..\SshSpeedDownloader.Transport\SshSpeedDownloader.Transport.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MoDiPrivateBuild)' == 'true' and '$(MoDiPrivateIdentityPath)' != ''">
    <EmbeddedResource Include="$(MoDiPrivateIdentityPath)" LogicalName="SshSpeedDownloader.Desktop.PrivateIdentity.key" />
    <AssemblyMetadata Include="MoDiBuildAudience" Value="Private" />
  </ItemGroup>

  <ItemGroup Condition="'$(MoDiPrivateBuild)' != 'true'">
    <AssemblyMetadata Include="MoDiBuildAudience" Value="Shared" />
  </ItemGroup>

  <Target Name="RequireMoDiPrivateIdentityPath" BeforeTargets="PrepareResources"
          Condition="'$(MoDiPrivateBuild)' == 'true' and '$(MoDiPrivateIdentityPath)' == ''">
    <Error Text="A private identity path is required for a private build." />
  </Target>

  <Target Name="ValidateMoDiPrivateIdentityPath" BeforeTargets="PrepareResources"
          Condition="'$(MoDiPrivateBuild)' == 'true' and '$(MoDiPrivateIdentityPath)' != '' and !Exists('$(MoDiPrivateIdentityPath)')">
    <Error Text="The requested private identity file path does not exist." />
  </Target>

  <Target Name="RemoveVendorSymbolsFromSingleFilePublish" AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <Delete Files="$(PublishDir)libHarfBuzzSharp.pdb;$(PublishDir)libSkiaSharp.pdb;$(PublishDir)SshSpeedDownloader.Core.pdb;$(PublishDir)SshSpeedDownloader.Transport.pdb" />
  </Target>
</Project>
