<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SshSpeedDownloader.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SshSpeedDownloader.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        Title="MoDi Downloader"
        Icon="/Assets/modi-downloader.ico"
        Width="1080" Height="760"
        MinWidth="840" MinHeight="600"
        Background="#F4F1E7"
        FontFamily="Inter, Microsoft YaHei UI">
    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FCFAF2" />
            <Setter Property="BorderBrush" Value="#DCD5C3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#5C6862" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#242A2D" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#47937F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="#EDE9DC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Foreground" Value="#47937F" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFEFA" />
            <Setter Property="BorderBrush" Value="#DCD5C3" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto,*" RowSpacing="14">
        <Border Grid.Row="0" BorderBrush="#DCD5C3" BorderThickness="0,0,0,1" Padding="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="/Assets/modi-downloader.png" Width="48" Height="48" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="MoDi Downloader" FontSize="19" FontWeight="SemiBold" Foreground="#242A2D" />
                        <TextBlock Text="墨堤 · 下载" Classes="label" />
                        <TextBlock Text="{Binding PrivateBuildNotice}" FontSize="11" Foreground="#9A5C1A" IsVisible="{Binding IsPrivateBuild}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="390">
                        <TextBlock Text="{Binding LocationText}" Foreground="#285D50" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TunnelStatusText}" Classes="label" HorizontalAlignment="Right" />
                    </StackPanel>
                    <TextBlock Text="{Binding TunnelCountText}" Classes="label" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalSpeedText}" FontWeight="SemiBold" Foreground="#285D50" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="292,*" ColumnSpacing="14">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Padding="6,4,6,16" BorderBrush="#DCD5C3" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Aliyun Beijing" FontWeight="SemiBold" FontSize="15" Foreground="#17312D" />
                                    <TextBlock Text="{Binding TunnelStatusText}" Classes="label" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="quiet" Content="重连" Command="{Binding ReconnectCommand}" IsEnabled="{Binding !IsConnected}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding TunnelCountText}" Classes="label" />
                            <StackPanel IsVisible="{Binding IsCloudEdition}" Spacing="7">
                                <TextBlock Text="{Binding DeviceIdentityText}" Classes="label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AuthorizationStatusText}" Classes="label" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="primary" Content="{Binding RequestAccessButtonText}"
                                            Command="{Binding RequestAccessCommand}" IsEnabled="{Binding CanRequestAccess}" />
                                    <Button Classes="quiet" Content="刷新状态"
                                            Command="{Binding RefreshApprovalStatusCommand}" IsEnabled="{Binding CanRefreshAccessStatus}" />
                                </StackPanel>
                            </StackPanel>
                            <Border IsVisible="{Binding NeedsCredentialSetup}" Background="#FFF7E8" BorderBrush="#E6CF9B" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{Binding StatusMessage}" Classes="label" TextWrapping="Wrap" Foreground="#6F531F" />
                                    <TextBox Text="{Binding UnlockPassphrase}" PasswordChar="●" PlaceholderText="私钥口令（只保存到本机凭据管理器）" />
                                    <Button Classes="primary" Content="保存并连接" Command="{Binding SaveUnlockPassphraseCommand}" />
                                </StackPanel>
                            </Border>
                            <Button Classes="quiet" Content="撤销本机授权" Command="{Binding RevokeLocalAuthorizationCommand}"
                                    IsVisible="{Binding CanRevokeLocalAuthorization}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="6,4,6,16" BorderBrush="#DCD5C3" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="9">
                            <TextBlock Text="云端总览" FontWeight="SemiBold" FontSize="15" Foreground="#17312D" />
                            <TextBlock Text="{Binding TotalSpeedText}" FontSize="28" FontWeight="SemiBold" Foreground="#285D50" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding TotalProgress}" />
                            <TextBlock Text="{Binding TotalProgressText}" Classes="label" />
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Text="{Binding ActiveTaskText}" Classes="value" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveConnectionsText}" Classes="value" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander Header="默认下载目录" IsExpanded="True">
                        <Border Classes="panel" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DefaultDownloadDirectory}" Classes="label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HasCustomDirectoryText}" Classes="label" />
                                <TextBlock Text="{Binding DirectoryMessage}" Foreground="#A43C37" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="quiet" Content="更改默认…" Click="BrowseDefaultFolder_Click" />
                                    <Button Classes="quiet" Content="恢复系统下载" Command="{Binding RestoreSystemDownloadsDirectoryCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="下载完成反馈">
                        <Border Classes="panel" Padding="12">
                            <StackPanel Spacing="9">
                                <CheckBox Content="播放完成提示音" IsChecked="{Binding CompletionSoundEnabled}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Slider Minimum="0" Maximum="100" Value="{Binding CompletionVolumePercent}" IsEnabled="{Binding CompletionSoundEnabled}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompletionVolumePercent, StringFormat='{}{0}%'}" Classes="label" VerticalAlignment="Center" />
                                </Grid>
                                <Button Classes="quiet" Content="试听" Command="{Binding PreviewCompletionSoundCommand}" IsEnabled="{Binding CompletionSoundEnabled}" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="高级信息">
                        <Border Classes="panel" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding IdentitySourceMessage}" Classes="label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConnectionDetail}" Classes="label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusMessage}" Classes="label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding IsPrivateBuild, StringFormat='私人身份随包：{0}'}" Classes="label" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="9">
                <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,4">
                    <StackPanel Spacing="2">
                        <TextBlock Text="下载任务" FontWeight="SemiBold" FontSize="17" Foreground="#17312D" />
                        <TextBlock Text="{Binding TotalProgressText}" Classes="label" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Tasks.Count, StringFormat='{}{0} 项'}" Classes="label" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" Classes="panel" Padding="12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding DownloadUrl}" PlaceholderText="粘贴 HTTP / HTTPS 下载链接" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrencyChoices}" SelectedItem="{Binding SelectedConcurrency}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="primary" Content="加入队列" Command="{Binding AddDownloadCommand}" IsEnabled="{Binding CanAddDownload}" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding TaskDownloadDirectory}" IsReadOnly="True" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="quiet" Content="本任务目录…" Click="BrowseTaskFolder_Click" />
                            <CheckBox Grid.Column="2" Content="自动寻优 1–64" IsChecked="{Binding AutoTuneConcurrency}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer IsVisible="{Binding HasTasks}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadTaskViewModel">
                                    <Border Classes="panel" Padding="14" Margin="0,0,0,10">
                                        <StackPanel Spacing="9">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="15" Foreground="#17312D" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusText}" Classes="label" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontWeight="SemiBold" Foreground="#285D50" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding SizeText}" Classes="label" />
                                                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Foreground="#285D50" FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding RemainingText}" Classes="label" />
                                                <TextBlock Grid.Column="1" Text="{Binding ConnectionsText}" Classes="label" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Classes="quiet" Content="暂停" IsVisible="{Binding CanPause}"
                                                        Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Classes="quiet" Content="继续" IsVisible="{Binding CanResume}"
                                                        Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Classes="quiet" Content="重试" IsVisible="{Binding CanRetry}"
                                                        Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Classes="quiet" Content="取消" IsVisible="{Binding CanCancel}"
                                                        Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Classes="quiet" Content="打开文件" IsVisible="{Binding CanOpen}"
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Classes="quiet" Content="所在目录" IsVisible="{Binding CanOpen}"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                            <Expander Header="任务详情">
                                                <StackPanel Spacing="6" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding SourceText}" Classes="label" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding TargetPath}" Classes="label" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ChunkText}" Classes="label" />
                                                    <TextBlock Text="{Binding RetryText}" Classes="label" />
                                                    <TextBlock Text="{Binding ErrorText}" Foreground="#A43C37" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                                                    <ItemsControl ItemsSource="{Binding Segments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DownloadSegmentViewModel">
                                                                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                                    <TextBlock Text="{Binding Label}" Classes="label" VerticalAlignment="Center" />
                                                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Progress}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding BytesText}" Classes="label" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel IsVisible="{Binding !HasTasks}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="340">
                        <TextBlock Text="下载队列是空的" FontSize="18" FontWeight="SemiBold" Foreground="#285D50" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
